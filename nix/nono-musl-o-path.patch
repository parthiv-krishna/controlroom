nono 0.80 for musl: open Landlock rule paths with O_PATH.

landlock's `PathFd::new` opens with `OpenOptions::custom_flags(O_PATH)`. On musl, O_ACCMODE
includes O_PATH, so Rust's standard library masks the flag off and the open becomes an ordinary
read, which the already-applied first Landlock layer denies: an approved mediated command (git
push) then fails with "cannot open / for Refer grant: Permission denied". nono already opens its
main rule paths with `nix::fcntl::open(O_PATH)` for this reason (`open_path_rule`); this does the
same for the execute-restriction layers. `PathBeneath::new` takes any `AsFd`.

--- a/crates/nono/src/sandbox/linux.rs
+++ b/crates/nono/src/sandbox/linux.rs
@@ -7,7 +7,7 @@
 use crate::sandbox::SupportInfo;
 use landlock::{
     ABI, Access, AccessFs, AccessNet, BitFlags, CompatLevel, Compatible, NetPort, PathBeneath,
-    PathFd, Ruleset, RulesetAttr, RulesetCreatedAttr, Scope,
+    Ruleset, RulesetAttr, RulesetCreatedAttr, Scope,
 };
 use nix::fcntl::{OFlag, open};
 use nix::sys::stat::Mode;
@@ -1444,7 +1444,7 @@
 
     for path in paths {
         let p = path.as_ref();
-        let fd = PathFd::new(p).map_err(|e| {
+        let fd = nix::fcntl::open(p, nix::fcntl::OFlag::O_PATH | nix::fcntl::OFlag::O_CLOEXEC, nix::sys::stat::Mode::empty()).map_err(|e| {
             NonoError::SandboxInit(format!(
                 "Command sandbox execute restriction: cannot open {}: {e}",
                 p.display()
@@ -1461,7 +1461,7 @@
     }
 
     if abi.has_refer() {
-        let root_fd = PathFd::new("/").map_err(|e| {
+        let root_fd = nix::fcntl::open("/", nix::fcntl::OFlag::O_PATH | nix::fcntl::OFlag::O_CLOEXEC, nix::sys::stat::Mode::empty()).map_err(|e| {
             NonoError::SandboxInit(format!(
                 "Command sandbox execute restriction: cannot open / for Refer grant: {e}"
             ))
