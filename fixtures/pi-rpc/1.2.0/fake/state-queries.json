    {"type": "dialog", "method": "confirm", "title": "Proceed?", "message": "This is a fixture dialog."},
    {"type": "dialog", "method": "input", "title": "Your name", "placeholder": "type a name"},
    {"type": "dialog", "method": "editor", "title": "Edit notes", "prefill": "line 1\nline 2"},
    {"type": "ui", "method": "notify", "message": "select=green confirm=true input=alice editor=<none>"},
    {"type": "ui", "method": "setStatus", "key": "fixture", "text": "dialogs done"},
    {"type": "ui", "method": "setWidget", "key": "fixture", "lines": ["fixture widget", "color: green"]},
    {"type": "ui", "method": "setTitle", "title": "fixture title"},
