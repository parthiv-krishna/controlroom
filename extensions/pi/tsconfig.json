{
  "//": "Type-checked by the extension-pi flake check. Locally, link pi first (see nix/extension.nix): node_modules/@earendil-works/pi-coding-agent -> the pinned pi package, whose node_modules provide @types/node.",
  "compilerOptions": {
    "target": "ES2022",
    "module": "ESNext",
    "moduleResolution": "bundler",
    "lib": ["ES2023"],
    "typeRoots": ["node_modules/@earendil-works/pi-coding-agent/node_modules/@types"],
    "types": ["node"],
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "verbatimModuleSyntax": true,
    "erasableSyntaxOnly": true,
    "allowImportingTsExtensions": true,
    "skipLibCheck": true,
    "noEmit": true
  },
  "include": ["src/**/*.ts", "test/**/*.ts"]
}
